{
  "name": "acc-slow: provider answers after the 3s read timeout (retried, then FAILED)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/provider/v1/execute",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.accountId", "equalTo": "acc-slow" } }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 5000,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "transactionId": "txn-too-late",
      "status": "APPROVED",
      "balance": 5500.00
    }
  }
}
